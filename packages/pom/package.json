{
  "name": "@hirokisakabe/pom",
  "version": "10.2.0",
  "description": "AI-friendly PowerPoint generation with a Flexbox layout engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clientApi": {
      "types": "./dist/clientApi.d.ts",
      "import": "./dist/clientApi.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/hirokisakabe/pom#readme",
  "bugs": {
    "url": "https://github.com/hirokisakabe/pom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirokisakabe/pom.git",
    "directory": "packages/pom"
  },
  "license": "MIT",
  "keywords": [
    "powerpoint",
    "pptx",
    "presentation",
    "slides",
    "typescript",
    "declarative",
    "flexbox",
    "layout",
    "office"
  ],
  "author": "Hiroki Sakabe",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint",
    "lint:deps": "depcruise src",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "vrt": "tsx vrt/runVrt.ts",
    "vrt:update": "tsx vrt/runVrt.ts --update",
    "vrt:docker": "docker compose build vrt && docker compose run --rm vrt",
    "vrt:docker:update": "docker compose build vrt-update && docker compose run --rm vrt-update",
    "preview": "tsx preview/lib/previewPptx.ts",
    "preview:docker": "docker compose build preview && docker compose run --rm preview",
    "docs:images": "tsx scripts/docs-images/generateNodeImages.ts",
    "docs:images:docker": "docker compose run --rm docs-images",
    "docs:images:docker:update": "docker compose build docs-images && docker compose run --rm docs-images",
    "docs:images:vrt": "tsx scripts/docs-images/generateNodeImages.ts --check",
    "docs:images:vrt:docker": "docker compose build docs-images-vrt && docker compose run --rm docs-images-vrt",
    "size": "size-limit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "lucide-static": "^1.25.0",
    "pixelmatch": "7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "size-limit": "^12.1.0",
    "tsdown": "^0.22.12",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@pptx-glimpse/document": "0.12.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.1.0",
    "fast-xml-parser": "^5.10.1",
    "image-size": "2.0.2",
    "jszip": "^3.10.1",
    "opentype.js": "^2.0.0",
    "yoga-layout": "3.2.1",
    "zod": "^4.4.3"
  }
}
