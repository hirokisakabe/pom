{
  "name": "@hirokisakabe/pom-cli",
  "version": "0.6.2",
  "description": "CLI tool for pom — preview, build, and render presentations",
  "type": "module",
  "bin": {
    "pom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/hirokisakabe/pom#readme",
  "bugs": {
    "url": "https://github.com/hirokisakabe/pom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirokisakabe/pom.git",
    "directory": "packages/pom-cli"
  },
  "license": "MIT",
  "author": "Hiroki Sakabe",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', '755')\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hirokisakabe/pom": "workspace:*",
    "@hirokisakabe/pom-md": "workspace:*",
    "commander": "^15.0.0",
    "pptx-glimpse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2"
  }
}
