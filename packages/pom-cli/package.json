{
  "name": "@hirokisakabe/pom-cli",
  "version": "0.9.1",
  "description": "CLI tool for pom — preview, build, and render presentations",
  "type": "module",
  "bin": {
    "pom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/hirokisakabe/pom#readme",
  "bugs": {
    "url": "https://github.com/hirokisakabe/pom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirokisakabe/pom.git",
    "directory": "packages/pom-cli"
  },
  "license": "MIT",
  "author": "Hiroki Sakabe",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:client && node -e \"require('fs').chmodSync('dist/cli.js', '755')\"",
    "build:client": "esbuild client/main.tsx --bundle --format=iife --platform=browser --target=es2022 --inject:client/react-shim.ts --minify --outfile=dist/assets/preview.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "knip": "knip",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hirokisakabe/pom": "workspace:*",
    "@hirokisakabe/pom-md": "workspace:*",
    "commander": "^15.0.0",
    "jszip": "^3.10.1",
    "pptx-glimpse": "^3.2.8"
  },
  "devDependencies": {
    "@hirokisakabe/pom-editor": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
