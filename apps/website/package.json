{
  "name": "pom-docs",
  "private": true,
  "scripts": {
    "dev": "next --turbopack",
    "build": "pnpm --filter @hirokisakabe/pom run build && pnpm --filter @hirokisakabe/pom-editor run build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fmt:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "vrt": "playwright test --config vrt/playwright.config.ts",
    "vrt:update": "playwright test --config vrt/playwright.config.ts --update-snapshots",
    "vrt:docker": "docker compose -f vrt/docker-compose.yml build vrt && docker compose -f vrt/docker-compose.yml run --rm vrt",
    "vrt:docker:update": "docker compose -f vrt/docker-compose.yml build vrt-update && docker compose -f vrt/docker-compose.yml run --rm vrt-update"
  },
  "dependencies": {
    "@hirokisakabe/pom": "workspace:*",
    "@hirokisakabe/pom-editor": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "next": "^16",
    "nextra": "^4",
    "nextra-theme-docs": "^4",
    "pptx-glimpse": "^5.3.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.4.0",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.10"
  }
}
